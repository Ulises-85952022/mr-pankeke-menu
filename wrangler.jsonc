{
  "name": "mr-pankeke",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/fotos/*"]
  },
  "kv_namespaces": [
    { "binding": "MENU_KV", "id": "ddcac7f2afba49a8af4bf085e7f130bd" }
  ],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "mr-pankeke-fotos" }
  ],
  "routes": [
    { "pattern": "mrpankeketepa.com", "custom_domain": true },
    { "pattern": "www.mrpankeketepa.com", "custom_domain": true },
    { "pattern": "admin.mrpankeketepa.com", "custom_domain": true }
  ]
}
